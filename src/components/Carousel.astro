---

<div class="embla" id="embla">
	<div class="embla__container">
		<slot />
	</div>
</div>

<style>
	.embla {
		overflow: hidden;
		width: 100%;
		z-index: 6;
		margin-bottom: 1.5rem;
		font-style: italic;
		text-align: center;
	}
	.embla__container {
		display: flex;
	}

	.embla__slide {
		flex: 0 0 100%;
		min-width: 0;
		cursor: grab !important;
	}
</style>

<script>
	import EmblaCarousel, {
		type EmblaCarouselType,
		type EmblaOptionsType,
	} from "embla-carousel";
	import Autoplay from "embla-carousel-autoplay";

	const options: EmblaOptionsType = { loop: true };
	let embla: EmblaCarouselType | null = null;

	// Runs on the initial load and after every ClientRouter navigation, which replaces the carousel element.
	document.addEventListener("astro:page-load", () => {
		const emblaNode = document.querySelector(".embla") as HTMLElement | null;
		if (!emblaNode) return;
		embla = EmblaCarousel(emblaNode, options, [
			Autoplay({ stopOnInteraction: false }),
		]);
	});

	// Stop the autoplay timer of the outgoing page before it is swapped out.
	document.addEventListener("astro:before-swap", () => {
		embla?.destroy();
		embla = null;
	});
</script>
