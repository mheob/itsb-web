---
import { faqDataDE, faqDataEN } from '@/data/faq';
import { contactPerson } from '@/data/service-contact';
import { serviceDataDE, serviceDataEN } from '@/data/services';
import { socialData } from '@/data/social';
import { useTranslations } from '@/utils/i18n';
import { getLocalizedRoute } from '@/utils/routes';

interface Props {
	/** Absolute URL of the image shown for the person and the business. */
	imageUrl: string;
}

const ui = {
	de: {
		catalog: 'Webdienstleistungen',
		jobTitle: 'Full-Stack-Entwickler',
	},
	en: {
		catalog: 'Web services',
		jobTitle: 'Full-stack developer',
	},
};

const lang = Astro.url.pathname.split('/')[1] === 'de' ? 'de' : 'en';
const t = useTranslations(ui, lang);
const { imageUrl } = Astro.props;

const services = lang === 'en' ? serviceDataEN : serviceDataDE;
const faqs = lang === 'en' ? faqDataEN : faqDataDE;
const homeUrl = new URL(getLocalizedRoute(lang, 'home'), Astro.site).href;
const siteUrl = new URL('/', Astro.site).href;
const personId = `${siteUrl}#person`;
const businessId = `${siteUrl}#business`;
const email = `mailto:${contactPerson.email}`;
const telephone = contactPerson.phone.replaceAll(' ', '');

// Same address as in the imprint (src/pages/imprint.astro, src/pages/de/impressum.astro).
const address = {
	'@type': 'PostalAddress',
	addressCountry: 'DE',
	addressLocality: 'Neuwied',
	addressRegion: 'Rheinland-Pfalz',
	postalCode: '56564',
	streetAddress: 'Theodor-Heuss-Str. 1',
};

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@id': `${siteUrl}#website`,
			'@type': 'WebSite',
			inLanguage: ['en', 'de'],
			name: contactPerson.name,
			publisher: { '@id': businessId },
			url: siteUrl,
		},
		{
			'@id': personId,
			'@type': 'Person',
			address,
			email,
			image: imageUrl,
			jobTitle: t('jobTitle'),
			knowsAbout: services.map((service) => service.header),
			name: contactPerson.name,
			sameAs: socialData.map((social) => social.href),
			telephone,
			url: siteUrl,
			worksFor: { '@id': businessId },
		},
		{
			'@id': businessId,
			'@type': 'ProfessionalService',
			address,
			areaServed: [
				{ '@type': 'City', name: 'Neuwied' },
				{ '@type': 'Country', name: 'Germany' },
			],
			email,
			founder: { '@id': personId },
			hasOfferCatalog: {
				'@type': 'OfferCatalog',
				itemListElement: services.map((service) => ({
					'@type': 'Offer',
					itemOffered: { '@type': 'Service', description: service.text, name: service.header },
				})),
				name: t('catalog'),
			},
			image: imageUrl,
			name: 'IT Service Böhm',
			telephone,
			url: homeUrl,
		},
		{
			'@id': `${homeUrl}#faq`,
			'@type': 'FAQPage',
			inLanguage: lang,
			mainEntity: faqs.map(({ question, answer }) => ({
				'@type': 'Question',
				acceptedAnswer: { '@type': 'Answer', text: answer },
				name: question,
			})),
			url: homeUrl,
		},
	],
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
